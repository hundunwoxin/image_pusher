name: Build & Package Jupyter AI Image
on:
  push:
    branches: [ main ]
    paths:
      - 'Dockerfile.persist'          # 仅当此文件变动时触发
      - '.github/workflows/*.yml'     # 允许更新 workflow 自身触发
  workflow_dispatch:                  # 添加手动触发按钮

jobs:
  build-and-package:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        # 如果遇到私有仓库需配置 token (公开仓库无需此行)
        # with:
        #   token: ${{ secrets.GITHUB_TOKEN }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to Container Registry (可选)
        if: github.event_name != 'pull_request'
        run: echo "${{ secrets.CONTAINER_REGISTRY_PASSWORD }}" | docker login -u "${{ secrets.CONTAINER_REGISTRY_USERNAME }}" --password-stdin
        # 注释掉上方行可跳过登录步骤（纯本地打包场景适用）

      - name: Build Docker image
        run: |
          docker build -f Dockerfile.persist -t jupyter-ai-persist:latest .
          # 添加更多标签示例：
          # docker tag jupyter-ai-persist:latest yourusername/jupyter-ai-persist:${{ github.sha }}

      - name: Save image as tarball
        run: |
          mkdir -p outputs && \
          docker save jupyter-ai-persist:latest > outputs/jupyter-ai-persist-image.tar && \
          gzip outputs/jupyter-ai-persist-image.tar          # 压缩节省空间

      - name: Upload Artifact
        uses: actions/upload-artifact@v4
        with:
          name: jupyter-ai-persist-image
          path: outputs/jupyter-ai-persist-image.tar.gz
          retention-days: 7              # 根据需求调整保留天数
